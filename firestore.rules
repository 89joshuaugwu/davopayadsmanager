rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isWhitelisted() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/whitelisted_users/$(request.auth.token.email));
    }

    // Whitelist collection: doc ID = email address, e.g. "joshuaugwu89@gmail.com"
    // Only readable server-side (Admin SDK bypasses rules). No client access at all.
    match /whitelisted_users/{email} {
      allow read, write: if false;
    }

    // All app data is written exclusively through the Admin-SDK-backed API routes
    // (see lib/auth-server.ts). Client SDK is only used for Firebase Auth itself,
    // so direct Firestore reads/writes from the browser are locked down here.
    match /gmailAccounts/{docId} {
      allow read, write: if false;
    }

    match /businessCenters/{docId} {
      allow read, write: if false;
    }

    match /adsAccounts/{docId} {
      allow read, write: if false;
    }

    match /adsDailyLogs/{docId} {
      allow read, write: if false;
    }

    match /businessCenterFunding/{docId} {
      allow read, write: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
